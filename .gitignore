node_modules/
# pnpm-lock.yaml is COMMITTED on purpose: without it every clone resolves its
# own dependency tree, and `pnpm add` damage cannot be undone with git.

# Internal working docs — not part of the public repo
HERMES_USAGE.md
_EVAL_PENDING.md

# Local scratch
*.log
*.bak
*.tmp
.DS_Store

# Internal plans/scratch — never in public repo
.hermes/


# Python bytecode from scripts/schema/ contracts
__pycache__/
*.py[cod]

# Packed tarballs from `pnpm pack` -- build output, not source
*.tgz
# ...but test fixtures are SOURCE. scripts/schema/fixtures/symlink-escape.tgz is a
# prebuilt malicious archive: it cannot be generated at test time because Windows
# refuses to create a symlink without elevation. A blanket *.tgz silently excluded
# it and a commit claiming to add it added nothing.
!scripts/schema/fixtures/*.tgz
